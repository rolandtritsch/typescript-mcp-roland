{
  "name": "typescript-mcp-roland",
  "version": "0.1.0",
  "description": "A very simple MCP server to explain who Roland is.",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-server": "./build/server.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/server.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
